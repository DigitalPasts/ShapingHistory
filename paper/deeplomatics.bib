@article{hainesImprovementsMethodFourier2000,
  title = {Improvements {{To The Method Of Fourier Shape Analysis As Applied In Morphometric Studies}}},
  author = {Haines, A. John and Crampton, James S.},
  year = 2000,
  journal = {Palaeontology},
  volume = {43},
